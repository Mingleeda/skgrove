# 로컬 AI 취합 프록시(OpenRouter) 설정 템플릿.
# 이 파일을 .env.ai.local 로 복사해 값을 채우세요 (.local 은 git 제외됨):
#   cp .env.ai.example .env.ai.local
#   node scripts/ai-proxy.mjs

# OpenRouter API 키 (https://openrouter.ai/keys). 절대 커밋하지 마세요.
OPENROUTER_API_KEY=sk-or-여기에_키

# 사용할 모델 슬러그 (https://openrouter.ai/models 에서 확인).
# 저렴·충분: anthropic/claude-haiku-4.5  |  품질↑: anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# 프록시 포트 (프론트의 VITE_AI_ENDPOINT 와 일치해야 함)
# PORT=8788
